        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "satisfied": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "value": {
                "type": [
