    "tile": {
      "type": "object",
      "properties": {
        "blackboard": {
          "type": ["array", "null"],
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "key": {"type": "string"},
              "value": {"type": "number"},
              "valueStr": {"type": ["string", "null"]}
