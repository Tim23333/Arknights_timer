          "type": "integer",
          "minimum": 0
        },
        "preDelay": {
          "type": [
            "number",
            "null"
          ]
        },
        "postDelay": {
          "type": [
            "number",
            "null"
          ]
        },
        "maxWait": {
          "type": [
            "number",
            "null"
          ]
        },
        "advancedTag": {
          "type": [
            "string",
            "null"
          ]
