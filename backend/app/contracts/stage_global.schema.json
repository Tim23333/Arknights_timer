            "string",
            "null"
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "handlerType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
