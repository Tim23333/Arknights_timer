        "randomGroup": {
          "type": [
            "string",
            "null"
          ]
        },
        "randomPack": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enemyId",
        "count",
        "selection"
