{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timeline:stage-global:1",
  "title": "Timeline 关卡全局状态兼容增量合同",
  "description": "Three topics carry optional projected fields. Null is meaningful only with a successful field record and its explicit reason. No memory addresses are public. Movement state does not imply physical displacement.",
