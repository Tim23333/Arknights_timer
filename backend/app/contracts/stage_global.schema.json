        "sourceFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "acceptedFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "latestKnownFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "collectionState": {
          "enum": [
            "current",
            "static",
            "not_collected",
            "unavailable",
            "historical"
          ]
        },
        "reason": {
          "type": "string"
        },
        "sampledAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "collectionState",
        "generation"
      ]
    },
    "records": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "collectionState": {
          "enum": ["current", "static", "not_collected", "unavailable", "historical"]
        },
        "reason": {"type": "string"},
        "sessionOrigin": {"type": "string"},
        "sessionOrdinal": {"type": "integer", "minimum": 0},
        "configurationRevision": {"type": ["string", "null"]},
        "acceptedAt": {"type": ["string", "null"]},
        "sourceFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runtimeFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "latestKnownFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "acceptedFrame": {
          "type": [
            "integer",
            "null"
          ]
        },
        "policyGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "frameConsistent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sampledAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceEpoch": {
          "type": "integer"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "origin": {
              "const": "bottom-left"
            },
            "x": {
              "const": "col"
            },
            "y": {
              "const": "row"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
