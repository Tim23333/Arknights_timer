        "fragmentIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actionIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "routeIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "preDelay": {
          "type": [
            "number",
            "null"
          ]
        },
        "interval": {
          "type": [
            "number",
            "null"
          ]
        },
        "selection": {
          "enum": [
            "confirmed",
            "conditional"
