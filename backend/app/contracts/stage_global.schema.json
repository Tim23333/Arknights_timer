    "clock": {
      "type": "object",
      "properties": {
        "gameTime": {
          "type": [
            "number",
            "null"
          ]
        },
        "fixedFrame": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "stageName": {
          "type": [
            "string",
            "null"
          ]
        },
        "stageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "levelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "isPaused": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "speedLevel": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timeScale": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/mode"
        },
        {
          "type": "null"
        }
      ]
    },
    "waves": {
      "type": "object",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/wave"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/wave"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextSelection": {
          "enum": [
            "known",
            "pending",
            "none",
            "unknown"
          ]
        },
        "nextEnemies": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/nextEnemy"
          }
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait": {
          "anyOf": [
            {
              "$ref": "#/$defs/wait"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "map": {
      "anyOf": [
        {
          "$ref": "#/$defs/map"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapRuntime": {
      "anyOf": [
        {
          "$ref": "#/$defs/mapRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "enemyLayout": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/enemy"
      }
    },
    "allyLayout": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ally"
      }
    },
    "fieldStates": {
      "$ref": "#/$defs/records"
    },
    "meta": {
