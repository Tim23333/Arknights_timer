    "wait": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fixed_wait",
            "timeout_budget",
            "mode_timer",
            "undetermined",
            "not_applicable",
            "unavailable"
          ]
        },
        "configuredSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalResumeCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "elapsedResumeCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remainingResumeCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remainingSeconds": {
          "type": [
            "number",
            "null"
          ]
