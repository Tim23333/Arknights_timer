    "gate": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "spawning",
            "fragment_block",
            "clearance_wait",
            "timeout_wait",
            "pre_delay",
            "post_delay",
            "mode_wait",
            "finished",
            "unknown"
          ]
        },
        "fragmentIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actionIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "blockingEnemyCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "blockCounter": {
          "type": [
            "integer",
            "null"
          ]
