# V2 replay and checkpoint identities include source bytes. Preserve the
# validated runtime and sealed content exactly across Git checkouts.
Ark_emulator/ark_sim/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/packages/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/scenarios/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/tests_v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/tools/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/validation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Ark_emulator/ark_emulator/levels/packs/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve verbatim terminal transcripts, including carriage returns/spaces.
Ark_emulator/ark_emulator/validation/reports/*.log -whitespace
Ark_emulator/ark_sim/validation/reports/*.log -whitespace
