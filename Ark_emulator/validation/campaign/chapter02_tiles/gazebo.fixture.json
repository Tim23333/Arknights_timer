  "rules": [
    {
      "id": "rule/ch2/tile_hp_ratio_recovery",
      "kind": "rule",
      "contract": "resource.recovery",
      "implementation": {
        "type": "expression",
        "expression": "inputs.current + inputs.delta_seconds * inputs.attributes.max_hp * inputs.attributes.hp_ratio_recovery"
      }
    },
    {
      "id": "rule/ch2/gazebo_flying_scale",
      "kind": "rule",
      "contract": "damage.request",
      "parameters": {
        "atk_scale": 1.7
      },
      "implementation": {
        "type": "graph",
        "nodes": [
          {
            "id": "result",
            "expression": "{'accepted':True,'effect':{'op':'damage','damage_type':inputs.effect.damage_type,'attack':inputs.effect.attack,'defense':inputs.effect.defense,'resistance':inputs.effect.resistance,'scale':inputs.effect.scale*params.atk_scale,'additions':inputs.effect.additions},'effects':[]}"
          }
        ],
        "output": "nodes.result"
      }
    }
