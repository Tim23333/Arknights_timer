      "activation": {
        "mode": "manual",
        "on_start": [
          {
            "op": "damage",
            "damage_type": "true"
          }
        ]
      },
      "timeline": []
    },
    {
      "id": "ability/withdraw",
      "kind": "ability",
      "selector": "selector/boss",
      "activation": {
        "mode": "manual",
        "on_start": [
