          "mode": "manual",
          "on_start": [
            {
              "op": "retire",
              "target": 2,
              "parameters": {
                "reason": "withdrawn"
              }
            }
          ]
        },
        "timeline": []
      },
      {
        "id": "ability/peer/foreign",
        "kind": "ability",
        "activation": {
          "mode": "manual",
          "on_start": [
            {
              "op": "apply_buff",
              "target": 2,
              "buff": "buff/peer/self_boost"
            }
          ]
        },
        "timeline": []
      }
    ],
