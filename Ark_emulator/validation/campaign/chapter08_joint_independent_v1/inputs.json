      ]
    },
    "rules": [
      {
        "id": "rule/peer/restore",
        "kind": "rule",
        "contract": "resource.recovery",
        "implementation": {
          "type": "expression",
          "expression": "inputs.parameters.capacity * inputs.parameters.ratio"
        }
      },
      {
        "id": "rule/peer/rate",
        "kind": "rule",
        "contract": "buff.lifetime_rate",
        "implementation": {
          "type": "expression",
          "expression": "1"
        }
      }
    ],
    "buffs": [
      {
        "id": "buff/peer/self_boost",
        "kind": "buff",
        "stacking": {
          "mode": "refresh",
          "identity": [
            "definition",
            "target"
          ]
        },
        "modifiers": [
          {
            "attribute": "max_hp",
            "layer": "direct_ratio",
            "value": 0.5
          },
          {
            "attribute": "atk",
            "layer": "direct_ratio",
            "value": 0.65
          }
        ]
      },
      {
        "id": "buff/peer/self_clock",
        "kind": "buff",
        "duration_seconds": 0.13333333333333333,
        "lifetime": {
          "rule": "rule/peer/rate",
          "parameters": {},
          "count_when_inactive": true
        }
      }
    ],
    "entities": [
      {
        "id": "unit/peer/boss",
        "kind": "entity",
        "components": {
          "spatial": {},
          "attributes": {
            "base": {
              "max_hp": 50000,
              "atk": 700,
              "def": 37,
              "mres": 17
            }
          },
          "resources": {
            "hp": {
              "initial": 50000,
              "capacity_attribute": "max_hp",
              "role": "health"
            }
          },
          "lifecycle": {
            "policy": "policy/ark_lifecycle"
          },
          "rebirth": {
            "resource": "hp",
            "max_count": 1,
            "delay_seconds": 0.16666666666666666,
            "restore_ratio": 0.5,
            "restore_rule": "rule/peer/restore",
            "retain_buffs": [
              "buff/peer/self_boost",
              "buff/peer/self_clock"
            ],
            "on_begin": [
              {
                "op": "apply_buff",
                "target": "self",
                "buff": "buff/peer/self_boost"
              },
              {
                "op": "apply_buff",
                "target": "self",
                "buff": "buff/peer/self_clock"
              }
            ]
          }
        }
      },
      {
        "id": "unit/peer/director",
        "kind": "entity",
        "components": {
          "spatial": {},
          "abilities": [
            "ability/peer/kill",
            "ability/peer/cancel",
            "ability/peer/foreign"
          ]
        }
      }
    ],
    "abilities": [
      {
        "id": "ability/peer/kill",
        "kind": "ability",
        "activation": {
          "mode": "manual",
          "on_start": [
            {
              "op": "instant_kill",
              "target": 2,
              "parameters": {
                "cause": "peer_joint",
                "skip_rebirth": false
              }
            }
          ]
        },
        "timeline": []
      },
      {
        "id": "ability/peer/cancel",
        "kind": "ability",
