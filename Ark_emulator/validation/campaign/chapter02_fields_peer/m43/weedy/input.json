      "implementation": {
        "type": "provider",
        "provider": "model.damage.request_field_transform"
      },
      "metadata": {
        "preserve_request": "All fields retained; custom pipeline may intentionally ignore scale, e.g. Weedy distance true damage.",
        "source_numeric_factor": 1.7,
        "native_true_damage_hook_behavior_pending": true
      }
    },
    {
      "contract": "damage.pipeline",
      "id": "rule/campaign_weedy_distance_damage",
      "implementation": {
        "nodes": [
          {
            "expression": "{\"accepted\": True, \"amount\": inputs.effect.distance * inputs.effect.parameters.value / inputs.effect.parameters.per_distance, \"allocations\": [], \"events\": []}",
            "id": "damage"
          }
        ],
        "output": "nodes.damage",
        "type": "graph"
      },
      "kind": "calculation_rule",
      "version": "1"
    }
