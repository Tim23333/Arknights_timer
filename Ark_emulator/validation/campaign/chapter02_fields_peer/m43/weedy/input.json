    {
      "id": "rule/ch2/tile_hp_ratio_recovery",
      "kind": "rule",
      "contract": "resource.recovery",
      "implementation": {
        "type": "expression",
        "expression": "inputs.current + inputs.delta_seconds * inputs.attributes.max_hp * inputs.attributes.hp_ratio_recovery"
