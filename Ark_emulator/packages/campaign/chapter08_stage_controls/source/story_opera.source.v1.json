  "story": {
    "key": "obt/tutorial/level/main_08-17",
    "fixed_payload_sha256": "f1183cb007820286a097d797035fc22394f4debb843ceaeb12cc48a4bcf0704d",
    "local_unpacked_payload_equal": true,
    "raw_utf8_script": "[HEADER(is_skippable=true, is_autoable=false)] 主线08-17关卡内剧情\n[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【科西切……你的阴谋必须被终结。就在这里】\n[PopupDialog(dialogHead=\"$avatar_bsnake\")]你的意识攻势怎么没那么清晰了？封住你的言语，让你的情感都无处宣泄了吗？\n[PopupDialog(dialogHead=\"$avatar_bsnake\")]即使你知道你面前是谁，即使你知道德拉克的火焰有多烈，即使你知道我对法术的了解远胜于你……\n[PopupDialog(dialogHead=\"$avatar_bsnake\")]你也想战胜我。你也想耗费我的精力。你也想让这具身躯背叛我。仅凭一把剑。\n[PopupDialog(dialogHead=\"$avatar_bsnake\")]仅凭一把仿造的剑。\n[PopupDialog(dialogHead=\"$avatar_chen2\")] 【明亮的目光】\n[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【令你阴谋破灭的不是一把剑，科西切。】\n[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【令你阴谋破灭的，是拿剑的人。】\n[Blocker(fadetime=0.3, block=true, a=0)]",
    "commands": [
      {
        "line": 1,
        "raw": "[HEADER(is_skippable=true, is_autoable=false)] 主线08-17关卡内剧情",
        "command": "HEADER",
        "parameter_text": "is_skippable=true, is_autoable=false",
        "text": "主线08-17关卡内剧情"
      },
      {
        "line": 2,
        "raw": "[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【科西切……你的阴谋必须被终结。就在这里】",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_amiya2\"",
        "text": "【科西切……你的阴谋必须被终结。就在这里】"
      },
      {
        "line": 3,
        "raw": "[PopupDialog(dialogHead=\"$avatar_bsnake\")]你的意识攻势怎么没那么清晰了？封住你的言语，让你的情感都无处宣泄了吗？",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_bsnake\"",
        "text": "你的意识攻势怎么没那么清晰了？封住你的言语，让你的情感都无处宣泄了吗？"
      },
      {
        "line": 4,
        "raw": "[PopupDialog(dialogHead=\"$avatar_bsnake\")]即使你知道你面前是谁，即使你知道德拉克的火焰有多烈，即使你知道我对法术的了解远胜于你……",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_bsnake\"",
        "text": "即使你知道你面前是谁，即使你知道德拉克的火焰有多烈，即使你知道我对法术的了解远胜于你……"
      },
      {
        "line": 5,
        "raw": "[PopupDialog(dialogHead=\"$avatar_bsnake\")]你也想战胜我。你也想耗费我的精力。你也想让这具身躯背叛我。仅凭一把剑。",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_bsnake\"",
        "text": "你也想战胜我。你也想耗费我的精力。你也想让这具身躯背叛我。仅凭一把剑。"
      },
      {
        "line": 6,
        "raw": "[PopupDialog(dialogHead=\"$avatar_bsnake\")]仅凭一把仿造的剑。",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_bsnake\"",
        "text": "仅凭一把仿造的剑。"
      },
      {
        "line": 7,
        "raw": "[PopupDialog(dialogHead=\"$avatar_chen2\")] 【明亮的目光】",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_chen2\"",
        "text": "【明亮的目光】"
      },
      {
        "line": 8,
        "raw": "[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【令你阴谋破灭的不是一把剑，科西切。】",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_amiya2\"",
        "text": "【令你阴谋破灭的不是一把剑，科西切。】"
      },
      {
        "line": 9,
        "raw": "[PopupDialog(dialogHead=\"$avatar_amiya2\")] 【令你阴谋破灭的，是拿剑的人。】",
        "command": "PopupDialog",
        "parameter_text": "dialogHead=\"$avatar_amiya2\"",
        "text": "【令你阴谋破灭的，是拿剑的人。】"
      },
