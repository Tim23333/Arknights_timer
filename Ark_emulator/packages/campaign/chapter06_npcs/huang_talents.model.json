  "rules": [
    {
      "id": "rule/ch6/npc/huang_undead",
      "kind": "calculation_rule",
      "contract": "damage.pipeline",
      "implementation": {
        "type": "expression",
        "expression": "{'accepted':inputs.effect.settlement.accepted,'amount':min(inputs.effect.settlement.amount,max(0,inputs.target.components.resources.hp.current-1)),'allocations':[],'events':[]}"
      }
    },
    {
      "id": "rule/ch6/npc/huang_hp_lock",
      "kind": "calculation_rule",
      "contract": "damage.pipeline",
      "implementation": {
        "type": "expression",
        "expression": "{'accepted':inputs.effect.settlement.accepted,'amount':min(inputs.effect.settlement.amount,max(0,inputs.target.components.resources.hp.current-0.5*inputs.target.components.attributes.base.max_hp)),'allocations':[],'events':[]}"
      }
    }
