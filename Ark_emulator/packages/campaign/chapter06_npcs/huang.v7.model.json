      "kind": "calculation_rule",
      "contract": "ability.windup",
      "parameters": {
        "minimum_speed": 0.01
      },
      "implementation": {
        "type": "expression",
        "expression": "inputs.timing_parameters.seconds/max(inputs.attributes.attack_speed_ratio,params.minimum_speed)"
      }
