      },
      "parameters": {
        "frozen": "buff/ch6/cold/e2c_freeze"
      }
    },
    {
      "id": "rule/ch6/cold/cold_active",
      "kind": "rule",
      "contract": "buff.applicability",
      "implementation": {
        "type": "expression",
        "expression": "inputs.owner.components.runtime.alive and 23 not in inputs.status.abnormal_immunes"
      }
    },
    {
      "id": "rule/ch6/cold/frozen_active",
      "kind": "rule",
      "contract": "buff.applicability",
      "implementation": {
        "type": "expression",
        "expression": "inputs.owner.components.runtime.alive and 16 not in inputs.status.abnormal_immunes"
