{
  "schemaVersion": 2,
  "rules": [
    {
      "id": "rule/linked/capacity",
      "kind": "rule",
      "contract": "elemental.capacity",
      "implementation": {
        "type": "expression",
        "expression": "inputs.parameters.capacity"
      }
    },
    {
      "id": "rule/linked/loss",
      "kind": "rule",
      "contract": "elemental.loss",
      "implementation": {
        "type": "expression",
        "expression": "max(0, inputs.request.raw_amount*(1-inputs.parameters.resistance*.01))"
      }
    },
    {
      "id": "rule/linked/recovery",
      "kind": "rule",
      "contract": "elemental.recovery",
      "implementation": {
        "type": "expression",
        "expression": "inputs.current"
      }
    },
    {
      "id": "rule/linked/duration",
      "kind": "rule",
      "contract": "elemental.break_duration",
      "implementation": {
        "type": "expression",
        "expression": "inputs.parameters.break_duration_seconds"
      }
    },
    {
      "id": "rule/linked/eligible",
      "kind": "rule",
      "contract": "elemental.eligibility",
      "implementation": {
        "type": "expression",
        "expression": "'neutral' not in inputs.target.tags"
      }
    },
    {
      "id": "rule/linked/packet",
      "kind": "rule",
      "contract": "elemental.packet",
      "implementation": {
        "type": "expression",
        "expression": "inputs.source_attributes.atk * inputs.request.parameters.ep_ratio"
      }
    },
    {
      "id": "rule/linked/motion",
      "kind": "rule",
      "contract": "projectile.trajectory",
      "implementation": {
        "type": "provider",
        "provider": "model.linked.homing"
      }
    }
  ],
