# Local data / secrets (adjust if you need to track samples)
*.env
.env.local
backend/data/timer_hook.json
# 用户本机运行选项（由程序写入，发布时使用默认值）
backend/app/custom_options.json

# 用户个人排轴缓存（保留示例 default.json）
backend/data/timeline_cache/*.json
!backend/data/timeline_cache/default.json

# 游戏解包数据（太大不提交；目录结构与解包方法见 data/README.md）
data/*
!data/README.md

# Ark_data 逆向产物中的超大/可再生成文件 (GitHub 单文件 100MB 限制;
# 由 Il2CppDumper 对游戏客户端重新生成, 见 data/README.md)
Ark_data/script.json
Ark_data/il2cpp.h
Ark_data/Il2CppDumper*.exe
Ark_data/DummyDll/


# 敌人扫描地址缓存 (每次扫描生成, 机器相关)
tools/enemy_health/enemy_cache.pkl
# 随游戏进程变化的随机数引擎寻址缓存
tools/ak_live_rng/ak_rng_cache.pkl

# ark_parser 提取的派生数据 (体积大, 可由脚本重新生成)
ark_parser/character/data/
ark_parser/enemy/data/

# 伤害计算器 (本地工具)
damage_calculator/

# 肉鸽解包工作区 (本地)
rougelike/

# 宣传视频本地素材与制作工作区
/promo_assets/
/promo_video_work/

# Local AssetBundle extraction workspace
/unpack_work/

# Exact-byte portable source bundle restores outside-root inputs here.
/external_sources/

